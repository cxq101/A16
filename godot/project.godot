; Engine configuration file. Managed project; open this file with Godot .NET.
config_version=5
[application]
config/name="碎光收藏室 · 三维流程样板"
run/main_scene="res://scenes/study.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
[rendering]
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
[dotnet]
project/assembly_name="A16Study"
