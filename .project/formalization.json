{
  "schemaVersion": 1,
  "standardVersion": "1.0.0",
  "phase": "formalized",
  "framework": {
    "name": "BaX",
    "versionSource": ".project/engine.json",
    "boundaryDocument": "docs/TECHNICAL.md"
  },
  "directories": [
    {
      "path": ".project",
      "purpose": "治理接入与项目级资产选择状态"
    },
    {
      "path": "docs",
      "purpose": "五份职责正文：项目概览、玩法与内容、美术、工程实现与维护、历史记录"
    },
    {
      "path": "outputs",
      "purpose": "既有输出预留目录，无权威职责"
    },
    {
      "path": "work",
      "purpose": "既有临时工作预留目录，无权威职责"
    },
    {
      "path": "godot",
      "purpose": "Godot .NET 三维流程样板；当前为三卡效果验证，不等同十二卡完整验证版"
    },
    {
      "path": "godot/game",
      "purpose": "卡牌状态、整理规则、存档载荷与领域校验"
    },
    {
      "path": "godot/world",
      "purpose": "场景、第一人称、桌面交互、卡牌几何和材质"
    },
    {
      "path": "godot/assets",
      "purpose": "唯一现行卡图、卡背与 source 中的提示词和来源清单，无浏览器素材依赖"
    },
    {
      "path": "godot/third_party/BaX",
      "purpose": "固定 v0.1.5 Git 子模块，公共机制；禁止业务逻辑侵入"
    },
    {
      "path": "godot/assets/source",
      "purpose": "当前保留美术的原始提示词与清单，.gdignore 隔离非运行资源"
    }
  ],
  "documents": [
    {
      "topic": "project-scope",
      "path": "docs/PROJECT.md",
      "section": "scope"
    },
    {
      "topic": "gameplay-and-progression",
      "path": "docs/GAMEPLAY.md",
      "section": "gameplay"
    },
    {
      "topic": "card-specification",
      "path": "docs/GAMEPLAY.md",
      "section": "cards"
    },
    {
      "topic": "art-direction",
      "path": "docs/ART.md",
      "section": "art"
    },
    {
      "topic": "interaction",
      "path": "docs/GAMEPLAY.md",
      "section": "interaction"
    },
    {
      "topic": "technical-baseline",
      "path": "docs/TECHNICAL.md",
      "section": "technical"
    },
    {
      "topic": "reference-evidence",
      "path": "docs/RECORDS.md",
      "section": "references"
    },
    {
      "topic": "governance",
      "path": "docs/TECHNICAL.md",
      "section": "governance"
    },
    {
      "topic": "handoff",
      "path": "docs/PROJECT.md",
      "section": "handoff"
    },
    {
      "topic": "art-selection-status",
      "path": ".project/artifacts.json"
    },
    {
      "topic": "migration-record",
      "path": "docs/RECORDS.md",
      "section": "migration"
    },
    {
      "topic": "project-progress",
      "path": "docs/PROJECT.md",
      "section": "progress"
    },
    {
      "topic": "pending-decisions",
      "path": "docs/PROJECT.md",
      "section": "open-questions"
    },
    {
      "topic": "validation-evidence",
      "path": "docs/RECORDS.md",
      "section": "godot-validation"
    }
  ],
  "versions": [
    {
      "object": "adopted-governance",
      "source": ".project/formalization.json",
      "selector": "$.standardVersion"
    },
    {
      "object": "formalization-profile-schema",
      "source": ".project/formalization.json",
      "selector": "$.schemaVersion"
    },
    {
      "object": "artifact-registry-schema",
      "source": ".project/artifacts.json",
      "selector": "$.schemaVersion"
    },
    {
      "object": "godot-engine",
      "source": ".project/engine.json",
      "selector": "$.engine.version"
    },
    {
      "object": "bax-version",
      "source": ".project/engine.json",
      "selector": "$.framework.version"
    },
    {
      "object": "bax-pinned-revision",
      "source": ".project/engine.json",
      "selector": "$.framework.commit"
    },
    {
      "object": "godot-sdk",
      "source": "godot/A16Study.csproj",
      "selector": "Project/@Sdk"
    },
    {
      "object": "godot-study-save-schema",
      "source": ".project/engine.json",
      "selector": "$.saveSchema"
    }
  ],
  "requiredFiles": [
    "AGENTS.md",
    "README.md",
    ".project/formalization.json",
    ".project/artifacts.json",
    "docs/PROJECT.md",
    ".project/validate-docs.cjs",
    "outputs/.gitkeep",
    "work/.gitkeep",
    ".gitignore",
    "docs/ART.md",
    ".project/engine.json",
    ".gitmodules",
    "godot/project.godot",
    "godot/A16Study.csproj",
    "godot/scenes/study.tscn",
    "godot/game/Session.cs",
    "godot/world/Study.cs",
    "godot/world/CardItem.cs",
    "godot/world/Room.cs",
    "godot/launch.cmd",
    "godot/assets/source/manifest.json",
    "godot/assets/source/.gdignore",
    ".gitattributes",
    "docs/GAMEPLAY.md",
    "docs/TECHNICAL.md",
    "docs/RECORDS.md"
  ],
  "exceptions": [
    {
      "rule": "production-versioning",
      "reason": "未有产品发布、正式资产包和存档架构，不补造统一版本",
      "scope": "尚未建立的生产版本对象",
      "reviewWhen": "建立生产构建和存档规范时"
    },
    {
      "rule": "validation-runtime",
      "reason": "本机 Python 应用别名不可运行，本次以可复跑 Node 检查覆盖接入结构和链接，不宣称技能原版 Python 检查已执行",
      "scope": "本次文档检查",
      "reviewWhen": "可用 Python 环境具备时补跑技能检查"
    },
    {
      "rule": "godot-study-scope",
      "reason": "用户要求先用 Godot 看效果，本轮三卡样板验证引擎与主要操作；完整十二卡验证版尚待扩展",
      "scope": "godot",
      "reviewWhen": "效果评审后进入十二卡完整验证版时"
    },
    {
      "rule": "framework-compatibility-scope",
      "reason": "BaX v0.1.5 固定接入 Godot 4.7.1 .NET，本轮仅验收实际使用的存档和节点/Tween 辅助，不宣称框架全部适配器回归",
      "scope": "godot/third_party/BaX 消费接入",
      "reviewWhen": "采用更多框架机制或升级引擎、核心库时"
    }
  ]
}
